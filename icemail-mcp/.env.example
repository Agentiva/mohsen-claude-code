# Icemail API key. Get it from the Icemail dashboard → API.
# Never commit the real value.
ICEMAIL_API_KEY=your-icemail-api-key

# Optional overrides
# ICEMAIL_BASE_URL=https://api.icemail.ai
# ICEMAIL_DOCS_URL=https://docs.icemail.ai
# ICEMAIL_TIMEOUT_MS=60000
# ICEMAIL_MAX_RETRIES=2

# Per-route overrides, if Icemail moves an endpoint (see src/endpoints.ts)
# ICEMAIL_PATH_MAILBOXES=/v1/mailboxes
# ICEMAIL_PATH_DOMAINS=/v1/domains
# ICEMAIL_PATH_EXPORTS=/v1/exports
# ICEMAIL_PATH_INBOX_THREADS=/v1/inbox/threads
# ICEMAIL_PATH_WEBHOOKS=/v1/webhooks
